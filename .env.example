# Заполняется автоматически: в Railway добавьте плагин Postgres к проекту
# (New -> Database -> Add PostgreSQL) — переменная DATABASE_URL появится
# сама и будет видна вашему сервису.

DATABASE_URL=

# Пароль для входа в /admin. Придумайте свой.
ADMIN_PASSWORD=

# Случайная длинная строка для подписи cookie сессии администратора.
ADMIN_SESSION_SECRET=

# Telegram-бот для дублирования заказов (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Отдельный Telegram-бот только для добавления товаров: пришлите ему фото
# с подписью-ценой — и товар сразу попадёт в каталог. Специально отдельный
# бот от TELEGRAM_BOT_TOKEN выше, чтобы уведомления о заказах не мешались
# с загрузкой товаров.
TELEGRAM_PRODUCTS_BOT_TOKEN=
TELEGRAM_PRODUCTS_CHAT_ID=

# Секрет для приёма вебхука от Telegram и для одноразовой команды
# регистрации вебхука. Придумайте случайную строку. После деплоя один раз
# вызовите:
#   curl -X POST https://ваш-домен/api/telegram/setup-webhook -H "x-setup-secret: <это значение>"
TELEGRAM_WEBHOOK_SECRET=

# Секрет для одноразового заполнения базы демо-товарами через /api/admin/seed
SEED_SECRET=

# Оплата картой через PayPal Checkout прямо на сайте. Client ID и Secret
# берутся из приложения на developer.paypal.com (My Apps & Credentials) —
# сначала протестируйте на Sandbox-приложении, потом переключитесь на Live.
# PAYPAL_ENV — "sandbox" (по умолчанию, тестовые платежи) или "live"
# (настоящие деньги). NEXT_PUBLIC_PAYPAL_CLIENT_ID — тот же Client ID, но
# доступен и в браузере (это не секрет, а публичный идентификатор
# приложения, без него не загрузится кнопка PayPal). PayPal не поддерживает
# тенге — сумма конвертируется в доллары по PAYPAL_USD_KZT_RATE (примерный
# курс, обновляйте вручную по мере надобности; по умолчанию 480).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_USD_KZT_RATE=480
