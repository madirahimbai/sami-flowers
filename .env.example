# Заполняется автоматически, когда в проекте Vercel подключены
# Storage -> Postgres и Storage -> Blob (кнопка Connect в панели Vercel).
# Локально: скопируйте этот файл в .env.local и вставьте значения
# из Vercel -> Settings -> Environment Variables.

POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# Пароль для входа в /admin. Придумайте свой.
ADMIN_PASSWORD=

# Случайная длинная строка для подписи cookie сессии администратора.
# Можно сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Telegram-бот для дублирования заказов (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для одноразового заполнения базы демо-товарами через /api/admin/seed
SEED_SECRET=
